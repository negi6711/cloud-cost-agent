# Cloud Cost Decision Snapshot — environment template.
# Placeholders only. Copy to `.env` for local development; never commit real values.

# development | test | staging | production (hosted deploys set staging/production)
APP_ENV=development

# --- Database (local: native Postgres; hosted: Supabase Postgres, US East) ---
# Runtime connections use cca_app (not the owner, subject to row-level security).
# Migrations use the schema owner.
DATABASE_URL=postgresql://cca_app:cca_app_local@localhost:5432/cca_dev
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/cca_dev
TEST_DATABASE_URL=postgresql://cca_app:cca_app_local@localhost:5432/cca_test
TEST_DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/cca_test

# --- Object storage ---
# local = filesystem adapter with HMAC-signed, expiring URLs (no cloud credentials needed)
# r2    = Cloudflare R2 private bucket via the S3 API
STORAGE_DRIVER=local
# Absolute path; `npm run env:init` fills it in.
LOCAL_STORAGE_DIR=/absolute/path/to/cloud-cost-agent/.local-storage
STORAGE_URL_SIGNING_SECRET=replace-with-32+-random-bytes
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
UPLOAD_MAX_BYTES=26214400
SIGNED_URL_TTL_SECONDS=300

# --- Web <-> worker ---
WORKER_URL=http://localhost:8001
WORKER_SHARED_SECRET=replace-with-32+-random-bytes

# --- Auth (magic link) ---
AUTH_SECRET=replace-with-32+-random-bytes
APP_BASE_URL=http://localhost:3000
ADMIN_EMAILS=you@example.com
# dev-inbox = emails written to DEV_INBOX_DIR and shown at /dev/inbox (refused when hosted)
# resend    = Resend API; without a verified domain it can only deliver to the account owner
EMAIL_DRIVER=dev-inbox
# Absolute path; `npm run env:init` fills it in.
DEV_INBOX_DIR=/absolute/path/to/cloud-cost-agent/.dev-inbox
RESEND_API_KEY=
EMAIL_FROM=

# --- TypeSafe Jev (read only by the Python worker; never by the web app) ---
# Classification runs only when the prospect ticked the consent box AND JEV_ENABLED=true.
JEV_ENABLED=false
# mock     = deterministic stand-in, labelled "Test classifier (not a real model)"; refused when hosted
# typesafe = the real API; needs TYPESAFE_API_KEY
JEV_PROVIDER=mock
TYPESAFE_API_KEY=
# Pinned version (required when hosted); aliases such as jev-latest move without notice.
JEV_MODEL=jev-1.13.0
JEV_BASE_URL=https://api.typesafe.ai
JEV_TIMEOUT_MS=30000
JEV_MAX_RETRIES=2
JEV_LOW_CONFIDENCE_THRESHOLD=0.5
# Yes/no answers have no confidence value: judged by distance from a coin toss (0.3 = at least 65% one way).
JEV_NOUL_MARGIN_THRESHOLD=0.3
JEV_CONCURRENCY=4

# --- Optional explanation LLM (Week 2; disabled by default) ---
EXPLANATION_LLM_ENABLED=false
EXPLANATION_LLM_PROVIDER=openai
EXPLANATION_LLM_MODEL=gpt-5-nano
OPENAI_API_KEY=

# --- Privacy ---
DATA_PROCESSING_CONSENT_REQUIRED=true
RAW_FILE_RETENTION_DAYS=30
